# Railway (sandbox orchestration)
RAILWAY_API_TOKEN=your_railway_token_here
RAILWAY_ENVIRONMENT_ID=your_environment_id_here

# Postgres (conversation + job persistence)
DATABASE_URL=postgresql://user:password@host:5432/glasses

# Telegram (first supported channel)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=123456789

# Server
PORT=3000
LOG_LEVEL=info

# Copilot CLI auth (falls back to `gh` CLI auth inside the sandbox if unset)
COPILOT_GITHUB_TOKEN=your_token_here
