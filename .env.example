# Railway (sandbox orchestration)
RAILWAY_API_TOKEN=your_railway_token_here
RAILWAY_ENVIRONMENT_ID=your_environment_id_here
# Set automatically by Railway for webhook registration.
RAILWAY_PUBLIC_DOMAIN=your-service.up.railway.app
JOB_TIMEOUT_SECONDS=3600
SCHEDULER_POLL_MS=2000
SCHEDULER_WORKER_CONCURRENCY=4

# Postgres (conversation + job persistence)
DATABASE_URL=postgresql://user:password@host:5432/glasses

# Telegram (first supported channel)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=123456789

# Server
PORT=3000
LOG_LEVEL=info

# Copilot SDK plus Contents/PR read-write access for worker clone and push
COPILOT_GITHUB_TOKEN=your_token_here

# Bounded main-session rehydration
MEMORY_MESSAGE_LIMIT=20
MEMORY_WORKER_LIMIT=10
